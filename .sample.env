# Copy to .env and adjust. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe())"
SECRET_KEY=GENERATE_A_NEW_SECRET_KEY

# 1 for local development, 0 in production
DEBUG=1

# Comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Set to 1 only when the site is served over HTTPS (forces secure cookies,
# HSTS and an HTTP->HTTPS redirect).
USE_HTTPS=0

SQL_ENGINE=django.db.backends.postgresql
POSTGRES_DB=django_real_estate
POSTGRES_USER=hello_django
POSTGRES_PASSWORD=hello_django
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Initial admin account, created on first start if it does not exist.
# Leave DJANGO_ADMIN_PASSWORD empty to skip automatic creation.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-me
